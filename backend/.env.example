# ─── Server & Environment ───────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
BACKEND_URL=http://localhost:5000
CLIENT_URL=http://localhost:5173
LOG_LEVEL=info

# ─── Database (MongoDB) ──────────────────────────────────────────────────────
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/shopai?retryWrites=true&w=majority
MONGO_MAX_POOL_SIZE=20

# ─── Cache & Queues (Redis & BullMQ) ────────────────────────────────────────
# Option A: Full Connection String (Upstash / Cloud Redis)
REDIS_URL=rediss://default:<password>@<host>:<port>

# Option B: Individual Host/Port Parameters
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TLS=false

# ─── Rate Limiting & Security ────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1000
RATE_LIMIT_AUTH_MAX=50
METRICS_AUTH_TOKEN=

# ─── JWT Authentication ─────────────────────────────────────────────────────
JWT_SECRET=your_jwt_secret_min_32_characters_long
JWT_REFRESH_SECRET=your_jwt_refresh_secret_min_32_characters_long
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── Google OAuth ───────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Stripe Payments & Webhooks ─────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ─── Email (Nodemailer / SMTP) ──────────────────────────────────────────────
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=ShopAI <no-reply@shopai.com>
